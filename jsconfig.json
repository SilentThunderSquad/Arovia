{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@app/*":       ["src/app/*"],
      "@features/*":  ["src/features/*"],
      "@shared/*":    ["src/shared/*"],
      "@styles/*":    ["src/styles/*"],
      "@pages/*":     ["src/pages/*"],
      "@lib/*":       ["src/lib/*"],
      "@constants/*": ["src/constants/*"],
      "@assets/*":    ["src/assets/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
